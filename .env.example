# WordPress headless REST API: https://piod.axworkflow.com/wp-json/wp/v2
WORDPRESS_API_URL=

# Latest posts from the professional @piodeportes account. Create a Meta
# Business app using Instagram API with Instagram Login and keep the token on
# the server. INSTAGRAM_USER_ID can remain "me" for the authorized account.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=me
INSTAGRAM_API_VERSION=v25.0

# Public address of the frontend.
NEXT_PUBLIC_SITE_URL=https://www.piodeportes.com

# Pio Deportes live radio stream discovered through the public TuneIn station feed.
NEXT_PUBLIC_RADIO_STREAM_URL=https://radio.streamingcpanel.com:7006/;

# Free sports feeds used directly by the server. MLB Stats API supplies MLB and
# LIDOM, while the NHL feed supplies hockey; neither needs a key. BALLDONTLIE
# supplies NBA and NFL scores after creating a free key at
# https://app.balldontlie.io/. TheSportsDB supplies football tournaments,
# schedules, results and a limited event timeline; its public free key is 123.
# Never prefix either configured value with NEXT_PUBLIC_.
BALLDONTLIE_API_KEY=
THESPORTSDB_API_KEY=123

# Optional normalized feed override for a future federation or commercial provider.
# When present, it takes priority over the free integrations above.
SPORTS_DATA_API_URL=
SPORTS_DATA_API_KEY=
SPORTS_DATA_API_HEADER=x-apisports-key
SPORTS_DATA_PROVIDER_NAME=

# Optional Google AdSense credentials. Direct ads can replace any AdSlot component.
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT=
NEXT_PUBLIC_GOOGLE_ADSENSE_TOP_SLOT=
NEXT_PUBLIC_GOOGLE_ADSENSE_RECTANGLE_SLOT=

# Server-side form delivery. Verify the piodeportes.com domain in Resend and
# use an address from that domain as the sender. Never expose these values with
# a NEXT_PUBLIC_ prefix.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Pío Deportes <portal@piodeportes.com>
ADVERTISING_INBOX=
NEWSLETTER_INBOX=info@piodeportes.com

# Optional mailing-list integration. This receives { email, source,
# consentedAt }. If omitted, subscriptions are stored in Redis and a notice is
# sent through Resend.
NEWSLETTER_WEBHOOK_URL=

# Durable, deployment-neutral storage for subscribers and the once-per-IP
# invitation. The IP is HMAC-hashed before the key is written.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEWSLETTER_POPUP_SALT=

# OneSignal Web Push. Create a Web app for https://www.piodeportes.com and copy
# its App ID here. Push permission is always requested from a user click.
NEXT_PUBLIC_ONESIGNAL_APP_ID=
